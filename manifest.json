const KEY="wealth-discipline-v4";
const defaults={cash:0,principal:0,transferred:0,stocks:{},history:[],settings:{preRate:10,postRate:50,buyFeeRate:.1425,sellFeeRate:.1425,taxRate:.3},marketUpdatedAt:null};
let db=load(),market={stocks:{},updatedAt:null,tradingDate:null,sources:[]},filter="all";
const $=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat("zh-TW",{style:"currency",currency:"TWD",maximumFractionDigits:0}).format(Number(n||0));
const num=n=>new Intl.NumberFormat("zh-TW",{maximumFractionDigits:2}).format(Number(n||0));
const now=()=>new Date().toISOString();
const fee=(amount,rate)=>amount*(Number(rate||0)/100);
function load(){try{const old=localStorage.getItem("wealth-discipline-v3")||localStorage.getItem("wealth_discipline_v1");const raw=localStorage.getItem(KEY)||old;const p=raw?JSON.parse(raw):{};return {...structuredClone(defaults),...p,settings:{...defaults.settings,...(p.settings||{})},stocks:p.stocks||{},history:p.history||[]}}catch{return structuredClone(defaults)}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function stockValue(){return Object.values(db.stocks).reduce((a,s)=>a+Number(s.qty||0)*Number(s.currentPrice||0),0)}
function totalWealth(){return stockValue()+db.cash+db.transferred}
function recovery(){return db.principal?db.transferred/db.principal*100:0}
function transferRate(){return db.principal>0&&db.transferred>=db.principal?db.settings.postRate:db.settings.preRate}
function render(){
 $("today").textContent=new Date().toLocaleDateString("zh-TW",{year:"numeric",month:"long",day:"numeric",weekday:"short"});
 $("transferredHero").textContent=money(db.transferred);const r=recovery();$("recoveryRate").textContent=`${num(r)}%`;$("progressBar").style.width=`${Math.min(100,r)}%`;$("stageLabel").textContent=db.principal>0&&db.transferred>=db.principal?"財富累積階段":"本金回收階段";
 $("stockValue").textContent=money(stockValue());$("cashValue").textContent=money(db.cash);$("principalValue").textContent=money(db.principal);$("wealthValue").textContent=money(totalWealth());$("cashPageValue").textContent=money(db.cash);$("transferPageValue").textContent=money(db.transferred);$("preRateSummary").textContent=`${num(db.settings.preRate)}%`;$("postRateSummary").textContent=`${num(db.settings.postRate)}%`;
 renderTasks();renderHoldings();renderHistory(filter);fillStocks();renderMarketStatus()
}
function getTasks(){const out=[];Object.values(db.stocks).forEach(s=>{if(s.currentPrice>0&&s.buyTarget>0&&s.currentPrice<=s.buyTarget&&s.buyQty>0)out.push({side:"buy",s,price:s.buyTarget,qty:s.buyQty});if(s.currentPrice>0&&s.sellTarget>0&&s.currentPrice>=s.sellTarget&&s.sellQty>0&&s.qty>0)out.push({side:"sell",s,price:s.sellTarget,qty:Math.min(s.sellQty,s.qty)})});return out}
function renderTasks(){const list=getTasks();$("taskCount").textContent=list.length;$("taskList").innerHTML="";if(!list.length){$("taskList").innerHTML='<div class="empty"><div style="font-size:34px">✓</div><b>今天沒有建議操作</b><div class="small">沒有訊號就不交易。</div></div>';return}list.forEach(t=>{const gross=t.price*t.qty;let note;if(t.side==="buy"){const total=gross+fee(gross,db.settings.buyFeeRate);note=`預估總支出 ${money(total)}，成交後可投資現金約 ${money(db.cash-total)}。`}else{const net=gross-fee(gross,db.settings.sellFeeRate)-fee(gross,db.settings.taxRate),tr=net*transferRate()/100;note=`預估淨入帳 ${money(net)}，建議轉出 ${money(tr)}，保留投資現金 ${money(net-tr)}。`}$("taskList").insertAdjacentHTML("beforeend",`<article class="task ${t.side}"><div class="task-head"><div><div class="symbol">${t.s.code}</div><div class="stock-name">${t.s.name||""}</div></div><div class="badge">${t.side==="buy"?"建議買進":"建議停利"}</div></div><div class="numbers"><div><span>${t.side==="buy"?"買進單價":"賣出單價"}</span><strong>${num(t.price)} 元</strong></div><div><span>${t.side==="buy"?"買進數量":"賣出數量"}</span><strong>${num(t.qty)} 股</strong></div></div><div class="explain">${note}</div><div class="button-row"><button class="primary" onclick="openComplete('${t.s.code}','${t.side}',${t.price},${t.qty})">✓ 已完成</button><button class="secondary" onclick="openComplete('${t.s.code}','${t.side}',${t.price},${t.qty})">修改成交</button></div></article>`)} )}
function marketDateLabel(s){const d=s.priceDate||market.tradingDate||"";return d?`<span class="data-tag">盤後資料 ${d}</span>`:""}
function renderHoldings(){const arr=Object.values(db.stocks).sort((a,b)=>a.code.localeCompare(b.code));$("holdingList").innerHTML="";if(!arr.length){$("holdingList").innerHTML='<div class="empty"><b>尚未建立股票</b><div class="small">按右下角＋新增。</div></div>';return}arr.forEach(s=>{const mv=s.qty*s.currentPrice,pnl=(s.currentPrice-s.avgCost)*s.qty;$("holdingList").insertAdjacentHTML("beforeend",`<article class="holding"><div class="holding-head"><div><div class="symbol">${s.code} ${s.name||""}</div><div class="stock-name">${s.market||""} · ${num(s.qty)} 股</div></div><div class="right"><strong>${money(mv)}</strong><div class="${pnl>=0?"positive":"negative"}">${pnl>=0?"+":""}${money(pnl)}</div></div></div><div class="holding-grid"><div><span>平均成本</span><strong>${num(s.avgCost)}</strong></div><div><span>參考價格</span><strong>${num(s.currentPrice)}</strong>${marketDateLabel(s)}</div><div><span>下次買進</span><strong>${num(s.buyTarget)}／${num(s.buyQty)}股</strong></div><div><span>下次賣出</span><strong>${num(s.sellTarget)}／${num(s.sellQty)}股</strong></div></div></article>`)} )}
function renderHistory(f="all"){filter=f;const names={buy:"買進",sell:"賣出",capital:"投入本金",transfer:"轉出",stock:"股票設定",price:"更新價格",settings:"策略設定"};const rows=db.history.filter(x=>f==="all"||x.type===f).slice().reverse();$("historyList").innerHTML="";if(!rows.length){$("historyList").innerHTML='<div class="empty">尚無紀錄</div>';return}rows.forEach(x=>$("historyList").insertAdjacentHTML("beforeend",`<div class="history-row"><div><strong>${names[x.type]||x.type} ${x.code||""}</strong><div class="small">${new Date(x.time).toLocaleString("zh-TW")}</div></div><div class="right"><strong>${x.qty?`${num(x.qty)}股`:""} ${x.price?`@ ${num(x.price)}`:""}</strong><div class="small">${x.amount!==undefined?money(x.amount):""}</div></div></div>`))}
function fillStocks(){$("stockSelect").innerHTML=Object.values(db.stocks).map(s=>`<option value="${s.code}">${s.code} ${s.name||""}</option>`).join("")}
function showView(name){document.querySelectorAll(".view").forEach(v=>v.classList.add("hidden"));$(`${name}View`).classList.remove("hidden");document.querySelectorAll(".nav").forEach(n=>n.classList.toggle("active",n.dataset.view===name))}
document.querySelectorAll(".nav").forEach(n=>n.addEventListener("click",()=>showView(n.dataset.view)));
document.querySelectorAll("[data-filter]").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll("[data-filter]").forEach(x=>x.classList.remove("active"));b.classList.add("active");renderHistory(b.dataset.filter)}));
function configure(type){$("recordType").value=type;const stock=type==="stock",trade=["buy","sell"].includes(type),price=type==="price",cash=["capital","transfer"].includes(type);$("stockLookupBlock").classList.toggle("hidden",!stock);$("stockSelectBlock").classList.toggle("hidden",!(trade||price));$("tradeBlock").classList.toggle("hidden",!trade);$("strategyBlock").classList.toggle("hidden",!stock);$("amountBlock").classList.toggle("hidden",!(cash||price))}
$("recordType").addEventListener("change",e=>configure(e.target.value));$("fab").addEventListener("click",()=>{configure("stock");$("recordDialog").showModal()});document.querySelectorAll("[data-action]").forEach(b=>b.addEventListener("click",()=>{configure(b.dataset.action);$("recordDialog").showModal()}));
async function loadMarket(force=false){if(market.updatedAt&&!force)return market;const res=await fetch(`market-data.json?ts=${Date.now()}`,{cache:"no-store"});if(!res.ok)throw new Error("market-data.json 尚未建立");const data=await res.json();market={stocks:data.stocks||{},updatedAt:data.updatedAt||null,tradingDate:data.tradingDate||null,sources:data.sources||[]};return market}
async function lookup(){const code=$("stockCode").value.trim();if(!code)return;$("stockCurrentPrice").value="";$("lookupStatus").textContent="查詢中…";$("lookupStatus").className="status";try{await loadMarket();const item=market.stocks[code];if(!item)throw new Error("找不到此股票代號");$("stockName").value=item.name||"";$("stockName").dataset.market=item.market||"";$("stockName").dataset.price=item.close||0;$("stockCurrentPrice").value=item.close||"";const d=item.date||market.tradingDate||"日期未提供";$("lookupStatus").textContent=`${item.market||""} · ${item.name||""} · 最新盤後收盤 ${num(item.close)} 元（${d}）`;$("lookupStatus").className="status ok"}catch(e){$("lookupStatus").textContent=`查詢失敗：${e.message}。可手動輸入名稱與價格。`;$("lookupStatus").className="status error"}}
$("lookupButton").addEventListener("click",lookup);let timer;$("stockCode").addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(lookup,500)});
async function refreshMarket(){try{await loadMarket(true);let updated=0;Object.values(db.stocks).forEach(s=>{const item=market.stocks[s.code];if(item){s.name=s.name||item.name;s.market=item.market||s.market;if(Number(item.close)>0){s.currentPrice=Number(item.close);s.priceDate=item.date||market.tradingDate||null;s.priceType="close";updated++}}});db.marketUpdatedAt=market.updatedAt;db.marketTradingDate=market.tradingDate;save();banner(`已更新 ${updated} 檔最新盤後收盤價。`,"ok")}catch(e){banner(`更新失敗：${e.message}`,"error")}}
$("refreshButton").addEventListener("click",refreshMarket);
function renderMarketStatus(){const text=market.updatedAt||db.marketUpdatedAt,date=market.tradingDate||db.marketTradingDate;$("marketStatus").textContent=text?`資料性質：盤後收盤價（非即時）。交易日期：${date||"未提供"}。檔案更新：${new Date(text).toLocaleString("zh-TW")}。來源：${market.sources.join("、")||"官方公開資料"}`:"尚未取得市場資料。GitHub Actions 執行後會自動建立。"}
function banner(text,type){$("banner").textContent=text;$("banner").className=`banner ${type}`;setTimeout(()=>$("banner").classList.add("hidden"),6000)}
function trade(code,side,price,qty){const s=db.stocks[code];if(!s)return alert("請先建立股票");if(price<=0||qty<=0)return alert("請輸入有效價格與股數");const gross=price*qty;if(side==="buy"){const total=gross+fee(gross,db.settings.buyFeeRate);if(total>db.cash)return alert("可投資現金不足");const nq=s.qty+qty;s.avgCost=(s.avgCost*s.qty+total)/nq;s.qty=nq;s.currentPrice=price;db.cash-=total;db.history.push({type:"buy",code,price,qty,amount:total,time:now()})}else{if(qty>s.qty)return alert("賣出股數超過持股");const net=gross-fee(gross,db.settings.sellFeeRate)-fee(gross,db.settings.taxRate);s.qty-=qty;s.currentPrice=price;if(s.qty===0)s.avgCost=0;db.cash+=net;db.history.push({type:"sell",code,price,qty,amount:net,time:now()});const suggestion=net*transferRate()/100;setTimeout(()=>{if(confirm(`本次淨入帳約 ${money(net)}。\n建議轉出 ${money(suggestion)}，現在記錄嗎？`)){db.cash-=suggestion;db.transferred+=suggestion;db.history.push({type:"transfer",amount:suggestion,time:now()});save()}},100)}}
$("saveRecord").addEventListener("click",()=>{const type=$("recordType").value,amount=Number($("amount").value||0),code=($("stockSelect").value||$("stockCode").value).trim();if(type==="stock"){const c=$("stockCode").value.trim();if(!c)return alert("請輸入股票代號");const old=db.stocks[c]||{code:c,name:"",qty:0,avgCost:0,currentPrice:0};db.stocks[c]={...old,name:$("stockName").value.trim(),market:$("stockName").dataset.market||old.market||"",currentPrice:Number($("stockCurrentPrice").value||$("stockName").dataset.price||old.currentPrice||0),priceDate:market.tradingDate||old.priceDate||null,priceType:$("stockCurrentPrice").value?"manual":"close",buyTarget:Number($("buyTarget").value||0),buyQty:Number($("buyQty").value||0),sellTarget:Number($("sellTarget").value||0),sellQty:Number($("sellQty").value||0)};db.history.push({type:"stock",code:c,time:now()})}else if(type==="capital"){if(amount<=0)return alert("請輸入金額");db.cash+=amount;db.principal+=amount;db.history.push({type:"capital",amount,time:now()})}else if(type==="transfer"){if(amount<=0||amount>db.cash)return alert("金額錯誤或現金不足");db.cash-=amount;db.transferred+=amount;db.history.push({type:"transfer",amount,time:now()})}else if(type==="price"){if(!db.stocks[code])return alert("請先建立股票");db.stocks[code].currentPrice=amount;db.stocks[code].priceDate=new Date().toLocaleDateString("zh-TW");db.stocks[code].priceType="manual";db.history.push({type:"price",code,price:amount,time:now()})}else trade(code,type,Number($("tradePrice").value),Number($("tradeQty").value));$("recordDialog").close();save()});
window.openComplete=(code,side,price,qty)=>{$("completeCode").value=code;$("completeSide").value=side;$("completePrice").value=price;$("completeQty").value=qty;$("completeTitle").textContent=`${code} ${side==="buy"?"買進":"賣出"}成交`;$("completeDialog").showModal()};
$("completeTrade").addEventListener("click",()=>{trade($("completeCode").value,$("completeSide").value,Number($("completePrice").value),Number($("completeQty").value));$("completeDialog").close();save()});
$("settingsButton").addEventListener("click",()=>{["preRate","postRate","buyFeeRate","sellFeeRate","taxRate"].forEach(k=>$(k).value=db.settings[k]);$("settingsDialog").showModal()});$("saveSettings").addEventListener("click",()=>{db.settings={preRate:Number($("preRate").value),postRate:Number($("postRate").value),buyFeeRate:Number($("buyFeeRate").value),sellFeeRate:Number($("sellFeeRate").value),taxRate:Number($("taxRate").value)};db.history.push({type:"settings",time:now()});$("settingsDialog").close();save()});
$("exportButton").addEventListener("click",()=>{const blob=new Blob([JSON.stringify(db,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`財富紀律備份_${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)});$("importButton").addEventListener("click",()=>$("importFile").click());$("importFile").addEventListener("change",e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const p=JSON.parse(r.result);db={...structuredClone(defaults),...p,settings:{...defaults.settings,...(p.settings||{})}};save();alert("匯入完成")}catch{alert("檔案格式錯誤")}};r.readAsText(f)});
render();loadMarket().then(()=>{renderMarketStatus();refreshMarket()}).catch(()=>renderMarketStatus());if("serviceWorker"in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{});
